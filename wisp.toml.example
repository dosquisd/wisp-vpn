# Wisp configuration file.
#
# Copy this file to `wisp.toml` in your user config directory
# (resolved by platformdirs; override with `WISP_CONFIG_DIR`).
# Fill in the values you need.
#
#   Linux:   ~/.config/wisp/wisp.toml (default)
#   macOS:   ~/Library/Application Support/wisp/wisp.toml (default)
#   Windows: %LOCALAPPDATA%\wisp\wisp.toml (default)
#
# Everything is OPTIONAL. The `[general]` section configures WispConfig
# (WireGuard / VM boot settings); the `[aws]`, `[oci]`, and `[gcp]` sections
# configure provider-specific defaults (each provider's own default region —
# there is NO shared cross-provider default region) plus, for OCI, the
# compartment and, for GCP, the project.
#
# Cloud credentials are NOT configured here. Each provider uses its standard
# CLI/SDK credential chain for authentication:
#   - AWS: env vars, ~/.aws/credentials, ~/.aws/config, IAM roles
#     (`aws configure` / environment variables)
#   - OCI: ~/.oci/config (profile-based), env vars (OCI_TENANCY, OCI_USER, ...)
#     (`oci setup config` / environment variables)
#   - GCP: GOOGLE_CREDENTIALS / GOOGLE_APPLICATION_CREDENTIALS env vars, ADC,
#     or gcloud (`gcloud auth application-default login`)


[general]
# Default provider used by `wisp` when invoked without a provider argument.
# Choices: "aws", "oci", "gcp"
# default_provider = "aws"        # uncomment to override (defaults to "aws")

# Per-session WispConfig defaults (all optional). When omitted, these fall
# back to the built-in constants.
# vm_boot_timeout = 60            # seconds to wait for the VM/SSH to come up
# wireguard_interface = "wg0"
# wireguard_ipv4 = "10.66.66.1"
# wireguard_dns1 = "1.1.1.1"
# wireguard_dns2 = "1.0.0.1"
# wireguard_port = 0              # 0 selects a random port (49152-65535)
# force_current_ip = false        # restrict firewall + AllowedIPs to /32
# confirm_destroy = true          # ask before tearing down the VPN from the
                                  # tunnel view; "don't ask again" in the
                                  # dialog flips this off and saves it here
# max_session_ttl_minutes = 60    # session lifetime cap for the OS-level
                                  # watchdog: it runs `wisp destroy` after the
                                  # TTL so a forgotten session cannot keep a
                                  # billable VM running forever (0 = off).
                                  # The deploy screen can override it per run.


[aws]
# AWS credentials are NOT configured here. The Pulumi deploy and boto3 use
# the standard AWS CLI/SDK credential chain (env vars, ~/.aws/credentials,
# ~/.aws/config, IAM roles). Configure them via the AWS CLI
# (`aws configure`) or environment variables instead.

# Default region for AWS deployments (used when no -r/--region is given).
# region = "us-east-2"


[oci]
# OCI credentials are NOT configured here. The Pulumi deploy and the OCI SDK
# use the standard OCI config chain (~/.oci/config profile-based, env vars
# OCI_TENANCY / OCI_USER / OCI_FINGERPRINT / OCI_PRIVATE_KEY_PATH / OCI_REGION).
# Configure them via `oci setup config` or environment variables instead.

# Profile name in ~/.oci/config to use (e.g. "DEFAULT", "work") — used to
# resolve credentials for region listing/validation.
# profile = "DEFAULT"

# Default region for OCI deployments (used when no -r/--region is given).
# e.g. "sa-bogota-1", "us-ashburn-1".
# region = ""

# Compartment OCID to deploy into (passed to the Pulumi deploy). If empty,
# defaults to the tenancy OCID (root compartment).
# compartment_ocid = ""


[gcp]
# All GCP fields are OPTIONAL except `project_id` (which can also be resolved
# from GOOGLE_CLOUD_PROJECT env var or gcloud defaults). Everything configured
# here is passed to the Pulumi deploy: the project, region, and zone go to the
# `gcp.Provider` resource, and `credentials_path` authenticates the deploy as
# the service account (bypassing the gcloud/ADC chain — see the Pulumi GCP
# docs, `credentials` accepts a path to the SA key JSON).

# GCP project ID to deploy into (e.g. "my-project-123456").
# project_id = ""

# Path to a service account key file (JSON) — authenticates the Pulumi deploy
# without the gcloud CLI (Console → IAM & Admin → Service Accounts → Keys).
# credentials_path = ""

# Default region for GCP deployments (used when no -r/--region is given).
# e.g. "us-central1", "europe-west1".
# region = ""

# Default zone for GCP deployments. If empty, derived as "{region}-a".
# e.g. "us-central1-a", "us-central1-f".
# zone = ""


[vps]
# Bring-your-own-server: Wisp configures WireGuard on a Linux host you already
# own, over SSH. Nothing is provisioned. On cleanup, Wisp tears down only the
# interface it created (named wisp-<hex>, never your own wg0): the tunnel is
# brought down, its config file deleted, and the firewall rules it added are
# removed — packages are kept. Authentication is public-key based: the
# host's authorized_keys must contain your public key (password auth is not
# supported).

# REQUIRED. The server's public hostname or IP.
# host = "203.0.113.10"

# SSH user to connect as (needs sudo for the WireGuard installer).
# ssh_user = "root"

# SSH port.
# ssh_port = 22

# Path to YOUR private key. If empty, your SSH agent/default keys are used.
# ssh_key_path = "~/.ssh/id_ed25519"
